@component-name = "portal-lima"
definition {

	property testray.main.component.name = "Blogs";

	setUp {
		TestCase.setUpPortalInstance();

		User.firstLoginPG();

		Navigator.openURL();
	}

	tearDown {
		var testPortalInstance = PropsUtil.get("test.portal.instance");

		if (${testPortalInstance} == "true") {
			PortalInstances.tearDownCP();
		}
	}

	@description = "Can Create a Blog"
	@priority = 5
	test CanCreateBlog {
		task ("Given: the Blogs Portlet is added to the page") {
			ProductMenu.gotoPortlet(
				category = "Content & Data",
				portlet = "Blogs");
		}

		task ("When: the user adds a Blog Entry") {
			Blogs.addEntry(
				entryContent = "first Blog",
				entryTitle = "first Blog");
		}

		task ("Then: the Blog Entry should display on the page") {
			Blogs.viewEntryPresent(entryTitle = "first Blog");
		}
	}

	@description = "Can Delete a Blog"
	@priority = 5
	test CanDeleteBlog {
		task ("Given: the Blogs Portlet is added to the page") {
			ProductMenu.gotoPortlet(
				category = "Content & Data",
				portlet = "Blogs");

			Blogs.addEntry(
				entryContent = "first Blog",
				entryTitle = "first Blog");

			Blogs.addEntry(
				entryContent = "second Blog",
				entryTitle = "second Blog");
		}

		task ("And: a 2 Blog Entries exists") {
			Blogs.viewEntryPresent(entryTitle = "first Blog");

			Blogs.viewEntryPresent(entryTitle = "second Blog");
		}

		task ("When: the User deletes Blog Entry 1") {
			LexiconEntry.gotoEntryMenuItemNoError(
				menuItem = "Delete",
				rowEntry = "first Blog");
		}

		task ("Then: Blog Entry 1 should not exist") {
			Blogs.viewEntryNotPresent(entryTitle = "first Blog");
		}

		task ("And: Blog Entry 2 should exist") {
			Blogs.viewEntryPresent(entryTitle = "second Blog");
		}
	}

	@description = "Can Edit a Blog"
	@priority = 5
	test CanEditBlog {
		task ("Given: the Blogs Portlet is added to the page") {
			ProductMenu.gotoPortlet(
				category = "Content & Data",
				portlet = "Blogs");

			Blogs.addEntry(
				entryContent = "first Blog",
				entryTitle = "first Blog");
		}

		task ("And: a Blog Entry exists") {
			Blogs.viewEntryPresent(entryTitle = "first Blog");
		}

		task ("When: the user Edit the Blog Entry") {
			LexiconEntry.gotoEntry(rowEntry = "first Blog");

			BlogsEntry.editEntryContent(
				entryContent = "first Blog",
				entryContentEdit = "first Blog edit",
				entryTitle = "first Blog",
				entryTitleEdit = "first Blog Edit");

			PortletEntry.publish();
		}

		task ("Then: the Blog Entry should be edited") {
			Blogs.viewEntryPresent(entryTitle = "first Blog Edit");
		}
	}

	@description = "Can Search Blogs"
	@priority = 5
	test CanSearchBlogs {
		task ("Given: the Blogs Portlet is added to the page") {
			ProductMenu.gotoPortlet(
				category = "Content & Data",
				portlet = "Blogs");

			Blogs.addEntry(
				entryContent = "first Blog",
				entryTitle = "first Blog");

			Blogs.addEntry(
				entryContent = "entry 2",
				entryTitle = "entry 2");
		}

		task ("And: a 2 Blog Entries exists") {
			Blogs.viewEntryPresent(entryTitle = "first Blog");

			Blogs.viewEntryPresent(entryTitle = "entry 2");
		}

		task ("When: the User searches for Blog Entry 1") {
			BlogsEntry.searchCP(
				entryContent = "first Blog",
				entrySearchTerm = "first Blog",
				entryTitle = "first Blog");
		}

		task ("Then: Blog Entry 1 should display") {
			Blogs.viewEntryPresent(entryTitle = "first Blog");
		}

		task ("And: Blog Entry 2 should not display") {
			Blogs.viewEntryNotPresent(entryTitle = "second Blog");
		}
	}

}